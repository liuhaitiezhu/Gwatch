{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Gwatch: Build Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "Gwatch: Flash Debug",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/programmer/2.23.0/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD", "mode=NORMAL", "reset=SWrst", "freq=1000",
                "-d", "${workspaceFolder}/build/Debug/spi_demo.elf",
                "-v", "-rst"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Gwatch: Build Debug",
            "problemMatcher": []
        },
        {
            "label": "Gwatch: Build Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "Gwatch: Flash Release",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/programmer/2.23.0/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD", "mode=NORMAL", "reset=SWrst", "freq=1000",
                "-d", "${workspaceFolder}/build/Release/spi_demo.elf",
                "-v", "-rst"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Gwatch: Build Release",
            "problemMatcher": []
        }
    ]
}
